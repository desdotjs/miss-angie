# Copy this file to .env (for running on your computer), or add these as
# Variables in Railway. Never commit your real .env.

# The passcode your mom types once to get in. Make it something she'll remember.
APP_PASSCODE=pick-something-sweet

# Optional. Signs her login cookie. If left out, the app makes one and keeps it in the database.
# SESSION_SECRET=

# Miss Angie's brain. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: which Claude model to use (default claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Her time zone, so "tonight" and "Sunday 7:30" mean her time.
TZ=America/Chicago

# Where the database lives. On Railway, point this at your volume (e.g. /data).
DATA_DIR=./data

# Optional. Phone notification keys. If left out, the app makes a pair once and keeps it in the database.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:you@example.com
